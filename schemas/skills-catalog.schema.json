{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "library_version",
    "plugin_display_name",
    "skills"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "plugin_display_name": {
      "const": "黃嘉偉KM"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "slug",
          "role",
          "version",
          "skill_path",
          "agent_path",
          "hashes",
          "category",
          "required_files"
        ],
        "properties": {
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "enum": [
              "menu",
              "teacher_tool",
              "student_skill"
            ]
          },
          "required_files": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "path",
                "target_path",
                "sha256",
                "normalized_text_sha256",
                "bytes"
              ],
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "normalized_text_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "path": {
                  "type": "string"
                },
                "target_path": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
